# Copy to config.env (same folder) and fill in. config.env is git-ignored: keep these links private.
# Google Photos > album > Teilen > "Link erstellen"
PHOTO_ALBUM=https://photos.app.goo.gl/XXXXXXXXXXXXXXXXX
# Google Calendar > Einstellungen > your calendar > Kalender integrieren > "Geheime Adresse im iCal-Format"
COMPANY_CALENDAR=https://calendar.google.com/calendar/ical/XXXX%40group.calendar.google.com/private-XXXX/basic.ics
# Google Slides > Teilen > link for "Jeder mit dem Link" (or Datei > Freigeben > Im Web veröffentlichen > Link)
SALES_SLIDES=https://docs.google.com/presentation/d/XXXXXXXXXXXXXXXX/edit?usp=sharing
